# Copy to .env and fill in values. Never commit real secrets.

# SQLite (local development). Use a PostgreSQL connection string in production.
DATABASE_URL="file:./dev.db"

# Auth.js (NextAuth v5)
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"

# Allow Auth.js to trust the host during local development.
AUTH_TRUST_HOST=true

# Seed credentials for the demo user (prisma/seed.ts)
SEED_EMAIL="demo@ratiolog.dev"
SEED_PASSWORD="password123"

# Signups are open by default. Set to "false" to make them invite-only.
# ALLOW_SIGNUP=false
