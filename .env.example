# Copy to .env and fill in values. Never commit real secrets.

# Database connection string.
# - Local development: SQLite file, e.g. "file:./dev.db"
# - Production (Turso/libSQL): the "libsql://..." URL from your Turso database
DATABASE_URL="file:./dev.db"

# Turso auth token (production). Create one in your Turso database settings.
TURSO_AUTH_TOKEN="replace-me"

# Auth.js (NextAuth v5)
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"

# Allow Auth.js to trust the host during local development.
AUTH_TRUST_HOST=true

# Seed credentials for the demo user (prisma/seed.ts)
SEED_EMAIL="demo@ratiolog.dev"
SEED_PASSWORD="password123"

# Signups are open by default. Set to "false" to make them invite-only.
# ALLOW_SIGNUP=false
